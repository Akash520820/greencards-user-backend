# ==============================================================================
# 👤 GreenCard — User Microservice Template (.env.example)
# ==============================================================================
NODE_ENV=production
PORT=5001
USER_SERVICE_PORT=5001

# MongoDB Atlas user_db connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/user_db?retryWrites=true&w=majority

ACCESS_TOKEN_SECRET=your_jwt_access_secret
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d

INTERNAL_API_SECRET=your_internal_cluster_shared_secret
ORDER_HMAC_SECRET=your_order_hmac_secret

SELLER_BACKEND_INTERNAL_URL=https://greencards-seller-backend.onrender.com
SUPERADMIN_BACKEND_INTERNAL_URL=https://greencards-superadmin-backend.onrender.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
