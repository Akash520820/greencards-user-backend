# GreenCards user-backend Environment Variables
PORT=5001
USER_SERVICE_PORT=5001
MONGODB_URI=mongodb://localhost:27017/greencards_user
CORS_ORIGIN=http://localhost:5173

# ES256 Token Configuration
# user-backend holds the CUSTOMER private key (signs customer/seller access tokens)
# and holds the STAFF public key to verify staff callers.
CUSTOMER_JWT_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
CUSTOMER_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
STAFF_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_string_min_32_chars
REFRESH_TOKEN_EXPIRY=10d
